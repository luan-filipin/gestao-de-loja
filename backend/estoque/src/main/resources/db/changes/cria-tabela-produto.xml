<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="luan">
        <createTable tableName="produto">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="id_categoria" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="quantidade" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="preco_pago" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="preco_venda" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="estoque_minimo" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="estoque_maximo" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="descricao" type="TEXT"/>

            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="data_cadastro" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="data_atualizacao" type="TIMESTAMP">
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>


